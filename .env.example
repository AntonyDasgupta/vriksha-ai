# Copy this file to a new file named ".env" (no .example) in the same folder,
# then fill in your real API key. NEVER commit the real .env file to GitHub —
# see .gitignore, which already excludes it.

# Get this key from https://console.anthropic.com (free tier available).
# This is optional — the app works without it (see backend/ai_synthesis.py),
# it just returns the raw researched text instead of an AI-smoothed version.
ANTHROPIC_API_KEY=your-key-here
